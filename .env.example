# Local API credentials for later phases. Copy to `.env` and fill in values.
# Phase 1 does not require any of these to build or validate the image.
# Never commit `.env`. Inject at runtime with: docker run --env-file .env ...

# OPENAI_API_KEY=
# TYPESAFE_API_KEY=
# OPENROUTER_API_KEY=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
