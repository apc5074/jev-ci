.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# OS / editor
.DS_Store
Thumbs.db
*.swp
*~

# Always-local regenerable API / embedding caches (keep directory placeholder)
cache/*
!cache/.gitkeep

# Accidental host-side Defects4J trees (canonical install is in the image)
/defects4j/
project_repos/

# Temporary working trees outside the tracked data layout
/work/
/tmp-checkouts/

Plans/
socs/

# docs/ and Plans/ are trackable (handoffs, phase tickets, design docs).

*.log

# Regenerable Defects4J working trees (Phase 3+)
data/bugs/**/checkouts/

# Generated compact test representations and their indexes
data/tests/**/representations/
data/tests/**/representations_index.json

# Keep trackable on purpose (do not blanket-ignore these):
#   data/manifest.json
#   EXPERIMENT.md
#   experiment.yaml
#   results/          (environment.json, metrics, figures — commit deliberately)
#   data/bugs|patches|tests|candidates when intentionally recorded
#   docs/ and Plans/ (project documentation)
